# Firebase Web App (Project settings → General → Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloud Messaging web push certificate (optional)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Local dev: Next.js rewrites /api/v1 to the Express server.
# Production (Vercel): set this to your deployed API, e.g. https://your-api.vercel.app/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Local only — omit on Vercel
API_PROXY_TARGET=http://localhost:5000
